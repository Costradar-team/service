FROM apache/airflow:2.10.5-python3.12

USER root

# The retailer collectors launch the system Chromium binary through Playwright.
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium xvfb xauth \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

RUN pip install --no-cache-dir "playwright>=1.52,<2"
